# ==============================================================================
# Running Activity Support System - Git Ignore Configuration
# Multi-Tier Ecosystem: Next.js Web + Android 16 Companion + Garmin Fenix 7s
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.iml
*.ipr
*.iws

# ------------------------------------------------------------------------------
# Node.js & Next.js Web App (apps/web-dashboard, packages/*)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/

# Next.js & Turbopack cache
.turbo/
.tsbuildinfo
next-env.d.ts

# Environment variables (Never commit sensitive keys or local overrides)
.env
.env*.local
!.env.example

# Testing & Coverage
coverage/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# Android 16 Companion Gateway (apps/android-companion)
# ------------------------------------------------------------------------------
# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
app/build/
**/build/

# Gradle files
.gradle/
build/
local.properties
.signing/

# Proguard / R8
proguard/
*.pro

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures
captures/

# External native build folder
.externalNativeBuild/
.cxx/

# Google Services / Firebase credentials
google-services.json

# ------------------------------------------------------------------------------
# Garmin Connect IQ (apps/garmin-fenix7s)
# ------------------------------------------------------------------------------
# Connect IQ compilation binaries and debug artifacts
*.prg
*.prg.debug.xml
apps/garmin-fenix7s/bin/
**/bin/

# Connect IQ RSA Signing Keys (CRITICAL: Never commit private developer keys)
*.der
*.pem
developer_key.*
developer_key

# Connect IQ local project settings
projectSettings.xml

# ------------------------------------------------------------------------------
# Spec Kit & Local Workspace
# ------------------------------------------------------------------------------
.specify/feature.json
.specify/extensions/*/local-config.yml

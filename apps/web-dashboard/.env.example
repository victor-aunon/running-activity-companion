# Athlete & Spectator Configuration
NEXT_PUBLIC_ATHLETE_NAME=Víctor
NEXT_PUBLIC_DEFAULT_LOCALITY="Alicante"
NEXT_PUBLIC_TARGET_PACE="4:30"
NEXT_PUBLIC_DEFAULT_RACE_DISTANCE_M=10000

# Dynamic Heart Rate Effort Zones (BPM)
NEXT_PUBLIC_ZONE_1_MAX=130
NEXT_PUBLIC_ZONE_2_MAX=145
NEXT_PUBLIC_ZONE_3_MAX=160
NEXT_PUBLIC_ZONE_4_MAX=175
NEXT_PUBLIC_ZONE_5_MAX=195

# Dynamic Cadence Steps-Per-Minute Ranges (SPM)
NEXT_PUBLIC_CADENCE_LOW_MAX=155
NEXT_PUBLIC_CADENCE_MODERATE_MAX=169
NEXT_PUBLIC_CADENCE_OPTIMAL_MAX=185

# Spectator Notification Triggers & Thresholds
NEXT_PUBLIC_NOTIF_EXERTION_HR_BPM=175
NEXT_PUBLIC_NOTIF_EXERTION_COOLDOWN_SEC=30
NEXT_PUBLIC_NOTIF_EXERTION_MAX_CONSECUTIVE=3
NEXT_PUBLIC_NOTIF_SPRINT_HR_BPM=175
NEXT_PUBLIC_NOTIF_SPRINT_CADENCE_SPM=180
NEXT_PUBLIC_NOTIF_SPRINT_FINAL_DISTANCE_M=2000
NEXT_PUBLIC_NOTIF_SPRINT_COOLDOWN_SEC=30
NEXT_PUBLIC_NOTIF_SPRINT_MAX_CONSECUTIVE=3

# WebSocket Connectivity (Relay Server default port: 3001)

{
  "name": "web-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --port 3000",
    "build": "next build",
    "start": "node --experimental-strip-types server.mjs",
    "lint": "next lint",
    "test": "node --test",
    "test:unit": "node --test tests/unit",
    "test:contract": "node --test tests/contract",
    "test:integration": "node --test tests/integration",
    "test:design": "playwright test --config=playwright.design.config.ts",
    "relay": "ts-node scripts/start-relay.ts",
    "simulate:runner": "ts-node scripts/simulate-runner.ts"
  },
  "dependencies": {
    "@running-support/shared-contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plus": "^1.3.0"
  }
}

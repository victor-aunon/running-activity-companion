{
  "name": "AuroraBentoLightDesignSystem",
  "version": "2.0.0",
  "theme": {
    "colorMode": "LIGHT",
    "colorModeLocked": true,
    "palette": {
      "background": {
        "canvas": "#F8FAFC",
        "surface": "#FFFFFF",
        "surfaceSubtle": "#F1F5F9",
        "surfaceFrosted": "rgba(255, 255, 255, 0.75)"
      },
      "aurora": {
        "glowOrange": "rgba(249, 115, 22, 0.16)",
        "glowAmber": "rgba(245, 158, 11, 0.12)",
        "glowRose": "rgba(244, 63, 94, 0.10)",
        "meshGradient": "radial-gradient(at 0% 0%, rgba(249, 115, 22, 0.14) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(245, 158, 11, 0.12) 0px, transparent 50%), radial-gradient(at 50% 100%, rgba(244, 63, 94, 0.08) 0px, transparent 50%)"
      },
      "border": {
        "subtle": "#E2E8F0",
        "card": "rgba(226, 232, 240, 0.8)",
        "focus": "#F97316"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#94A3B8"
      },
      "status": {
        "sent": "#0284C7",
        "delivered": "#10B981",
        "thanked": "#8B5CF6",
        "expired": "#64748B"
      },
      "effortZones": {
        "source": "ENVIRONMENT_VARIABLES",
        "defaults": {
          "zone1_recovery": { "color": "#0284C7", "envKey": "NEXT_PUBLIC_ZONE_1_MAX" },
          "zone2_aerobic": { "color": "#16A34A", "envKey": "NEXT_PUBLIC_ZONE_2_MAX" },
          "zone3_tempo": { "color": "#D97706", "envKey": "NEXT_PUBLIC_ZONE_3_MAX" },
          "zone4_threshold": { "color": "#EA580C", "envKey": "NEXT_PUBLIC_ZONE_4_MAX" },
          "zone5_anaerobic": { "color": "#DC2626", "envKey": "NEXT_PUBLIC_ZONE_5_MAX" }
        }
      }
    },
    "typography": {
      "fontFamilySans": "Inter, system-ui, -apple-system, sans-serif",
      "fontFamilyMono": "JetBrains Mono, ui-monospace, monospace",
      "metricValue": {
        "fontSize": "3.25rem",
        "fontWeight": "700",
        "letterSpacing": "-0.03em",
        "lineHeight": "1"
      },
      "bentoTitle": {
        "fontSize": "0.8125rem",
        "fontWeight": "600",
        "textTransform": "uppercase",
        "letterSpacing": "0.06em",
        "color": "#64748B"
      }
    },
    "bento": {
      "cardRadius": "10px",
      "cardShadow": "0 4px 20px -1px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03)",
      "cardBackdropBlur": "blur(16px)",
      "gap": "1.25rem"
    }
  }
}
